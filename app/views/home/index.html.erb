<div class="page">
  <header class="site-header">
    <%= link_to root_path, class: "brand", aria: { label: "Household Food Manager home" } do %>
      <span class="brand-mark" aria-hidden="true">h.</span>
      <span>Household<br>Food Manager</span>
    <% end %>
    <span class="edition">A fresh start</span>
  </header>

  <main id="main">
    <section class="welcome" aria-labelledby="welcome-title">
      <div class="welcome-copy">
        <p class="eyebrow">Good food. Thoughtfully managed.</p>
        <h1 id="welcome-title">A little less waste.<br>A little more ease.</h1>
        <p class="intro">A simpler home for your household's food, with room for the everyday routines that make a kitchen yours.</p>
        <a class="text-link" href="#foundation">Meet your starting point <span aria-hidden="true">&darr;</span></a>
      </div>

      <aside class="welcome-card" aria-labelledby="card-title">
        <div class="card-symbol" aria-hidden="true">
          <svg viewBox="0 0 120 120" fill="none">
            <path d="M60 99V55M60 72C30 73 20 52 24 29C48 29 62 44 60 72ZM60 58C58 32 73 18 98 18C100 44 84 60 60 58Z" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M37 99H83" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
          </svg>
        </div>
        <p class="eyebrow">Small beginnings, everyday possibilities</p>
        <h2 id="card-title">Make space for<br>a simpler kitchen.</h2>
        <p>One household. One place to begin.</p>
      </aside>
    </section>

    <section id="foundation" class="foundation" aria-labelledby="foundation-title">
      <div>
        <p class="eyebrow">The foundation</p>
        <h2 id="foundation-title">Ready to grow with you.</h2>
      </div>
      <div class="foundation-copy">
        <p>This is the first working page of Household Food Manager. It's built for a comfortable experience on your phone and your desktop.</p>
        <p>Food management features aren't available yet. For now, we're keeping things simple and getting the basics right.</p>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <span>Household Food Manager</span>
    <span>A thoughtful start to everyday food.</span>
  </footer>
</div>
